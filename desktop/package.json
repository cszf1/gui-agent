{
  "name": "gui-agent-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "A desktop app for natural-language computer control",
  "author": "cszf1",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:build": "python scripts/build-worker.py",
    "dist:win": "node scripts/check-resources.mjs win32 && npm run build && electron-builder --win nsis",
    "dist:dir": "node scripts/check-resources.mjs && npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "io.github.cszf1.gui-agent",
    "productName": "GUI Agent",
    "directories": {"output": "release"},
    "files": ["out/**/*", "package.json", "assets/icon.png"],
    "icon": "assets/icon.png",
    "extraResources": [{"from": "resources", "to": "worker", "filter": ["**/*"]}],
    "win": {"target": "nsis", "icon": "assets/icon.ico", "artifactName": "GUI-Agent-${version}-${arch}-Setup.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true},
    "mac": {"target": "dmg", "category": "public.app-category.productivity"},
    "linux": {"target": "AppImage", "category": "Utility"}
  }
}
